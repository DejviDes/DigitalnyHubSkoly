{
  "version": 2,
  "routes": [
    {
      "src": "^/api/contact$",
      "dest": "/api/contact.js"
    },
    {
      "src": "^/pages/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/pages/kontakt\\.html$",
      "status": 308,
      "headers": {
        "Location": "/#kontakt"
      }
    },
    {
      "src": "^/pages/cennik\\.html$",
      "status": 308,
      "headers": {
        "Location": "/#cena"
      }
    },
    {
      "src": "^/pages/faq\\.html$",
      "status": 308,
      "headers": {
        "Location": "/#faq"
      }
    },
    {
      "src": "^/pages/moduly\\.html$",
      "status": 308,
      "headers": {
        "Location": "/#moduly"
      }
    },
    {
      "src": "^/pages/modul-personalna-agenda\\.html$",
      "status": 308,
      "headers": {
        "Location": "/#moduly"
      }
    },
    {
      "src": "^/pages/modul-ekonomicka-agenda\\.html$",
      "status": 308,
      "headers": {
        "Location": "/#moduly"
      }
    },
    {
      "src": "^/pages/modul-majetok-infrastruktura\\.html$",
      "status": 308,
      "headers": {
        "Location": "/#moduly"
      }
    },
    {
      "src": "^/pages/modul-pedagogicka-agenda\\.html$",
      "status": 308,
      "headers": {
        "Location": "/#moduly"
      }
    },
    {
      "src": "^/pages/modul-spatna-vazba-porady\\.html$",
      "status": 308,
      "headers": {
        "Location": "/#moduly"
      }
    },
    {
      "src": "^/pages/riesenie\\.html$",
      "status": 308,
      "headers": {
        "Location": "/#ako-to-funguje"
      }
    },
    {
      "src": "^/pages/ako-to-funguje\\.html$",
      "status": 308,
      "headers": {
        "Location": "/#ako-to-funguje"
      }
    },
    {
      "src": "^/pages/porovnanie\\.html$",
      "status": 308,
      "headers": {
        "Location": "/#microsoft-365"
      }
    },
    {
      "src": "^/pages/o-projekte\\.html$",
      "status": 308,
      "headers": {
        "Location": "/#o-mne"
      }
    },
    {
      "src": "^/pages/ochrana-osobnych-udajov\\.html$",
      "status": 308,
      "headers": {
        "Location": "/ochrana-osobnych-udajov.html"
      }
    },
    {
      "src": "^/pages/vyhody-[a-z-]+\\.html$",
      "status": 308,
      "headers": {
        "Location": "/#pre-koho"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/.*$",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
